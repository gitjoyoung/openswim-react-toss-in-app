# 실제 값은 .env에 넣으세요 (.env는 커밋되지 않습니다).
# 카카오맵 JS 키 (카카오 개발자 콘솔 > 앱 > 앱 키 > JavaScript 키)
# 사용 도메인을 [플랫폼 > Web]에 등록해야 지도가 뜹니다.
VITE_KAKAO_JS_KEY=

# Neon 공개 데이터 조회 주소입니다. VITE_* 값은 앱 번들에 포함되므로
# DB 연결 문자열(NEON_DATABASE_URL)이나 관리 API 키(NEON_API_KEY)는 절대 넣지 마세요.
VITE_NEON_DATA_API_URL=https://ep-still-cell-azkp4rh4.apirest.c-3.ap-southeast-1.aws.neon.tech/neondb/rest/v1
VITE_NEON_AUTH_URL=https://ep-still-cell-azkp4rh4.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth

# 운영용 DB 동기화 스크립트에서만 사용하는 비밀값 예시입니다.
# 이 값들은 VITE_ 접두사 없이 로컬 셸 또는 배포 환경의 서버 시크릿으로만 설정하세요.
# NEON_DATABASE_URL=postgresql://...
# NEON_API_KEY=napi_...

# 앱인토스 인앱 광고 배너 그룹 ID (콘솔 > 수익화 > 인앱 광고). 비우면 배너를 그리지 않습니다.
VITE_TOSS_AD_GROUP_ID=
# 상세 화면(시간표 아래) 배너 그룹 ID. 홈과 따로 만들면 자리별 성과를 볼 수 있습니다.
VITE_TOSS_AD_GROUP_ID_DETAIL=
